+	/// <summary>Port: while the windows are arranged around DOSBox, a window that opens over DOSBox (centered on the
+	/// map, the original's place for a window without a saved one, or saved there) moves to the nearest place on
+	/// DOSBox's screen clear of DOSBox, overlapping the other open windows as little as possible.</summary>
+	private void KeepOffDOSBox(Form form)
+	{
+		if (m_bArrangedThisSession && Settings.Default.ForceDosBoxLocation && Hacker != null && Hacker.IsValid)
+		{
+			MoveOffDOSBox(form);
+		}
+	}
+
+	private void MoveOffDOSBox(Form form)
+	{
+		Rectangle rcDOSBox = Hacker.GetDOSBoxRect();
+		if (rcDOSBox.Width < 100 || rcDOSBox.Height < 100)
+		{
+			return;
+		}
+		Rectangle db = FrameRect(Hacker.DOSBoxWindow, rcDOSBox);
+		Rectangle rc = form.Bounds;
+		Rectangle overlap = Rectangle.Intersect(rc, db);
+		if (overlap.Width <= 16 || overlap.Height <= 16)
+		{
+			return;
+		}
+		Rectangle wa = MonitorOf(rcDOSBox, bWorkArea: true);
+		List<Rectangle> others = new List<Rectangle>();
+		foreach (Form value in Forms.Values)
+		{
+			if (value != form)
+			{
+				others.Add(value.Bounds);
+			}
+		}
+		long bestScore = long.MaxValue;
+		Point best = rc.Location;
+		int maxX = Math.Max(wa.Left, wa.Right - rc.Width);
+		int maxY = Math.Max(wa.Top, wa.Bottom - rc.Height);
+		for (int y = wa.Top; y <= maxY; y += 8)
+		{
+			for (int x = wa.Left; x <= maxX; x += 8)
+			{
+				Rectangle candidate = new Rectangle(x, y, rc.Width, rc.Height);
+				Rectangle onDOSBox = Rectangle.Intersect(candidate, db);
+				long score = (long)onDOSBox.Width * onDOSBox.Height * 1000;
+				foreach (Rectangle other in others)
+				{
+					Rectangle under = Rectangle.Intersect(candidate, other);
+					score += (long)under.Width * under.Height;
+				}
+				// ties: nearest to where the window would have opened
+				long dx = x - rc.X;
+				long dy = y - rc.Y;
+				score = score * 4096 + Math.Min(4095, (long)Math.Sqrt(dx * dx + dy * dy));
+				if (score < bestScore)
+				{
+					bestScore = score;
+					best = new Point(x, y);
+				}
+			}
+		}
+		form.Location = best;
+	}
