diff --git a/WhereAreWe/BTMemoryHacker.cs b/WhereAreWe/BTMemoryHacker.cs
index e9c1b94cc03deea1efdbcaf524f7bc6ec8f17495..22ac9ea83f51b4adbf29222167d4e68dd67df0a2 100644
--- a/WhereAreWe/BTMemoryHacker.cs
+++ b/WhereAreWe/BTMemoryHacker.cs
@@ -154,6 +154,45 @@ public abstract class BTMemoryHacker : MemoryHacker
 		return null;
 	}
 
+	/// <summary>Port: how deep below Memory.Stack the game's stack pointer is (the stack window's live part is
+	/// shallower; deeper bytes are left over from earlier calls), -1 if unknown.</summary>
+	protected int LiveStackDepth()
+	{
+		if (!DosboxApi.StackPointer(out long sp))
+		{
+			return -1;
+		}
+		long depth = (long)FoundBlockOffset - DosboxApi.BlockHeader + Memory.Stack - sp;
+		if (depth <= 0 || depth > Memory.StackSize)
+		{
+			return -1;
+		}
+		return (int)depth;
+	}
+
+	/// <summary>Port: the state whose return address sits anywhere in the live part of the stack window, the first
+	/// of the given (address, state) pairs that does; the stack index of the find goes to iIndex.</summary>
+	protected static MainState LiveStackState(byte[] stack, int liveDepth, KeyValuePair<int, MainState>[] states, out int iIndex)
+	{
+		iIndex = -1;
+		if (stack == null || liveDepth <= 0)
+		{
+			return MainState.Unknown;
+		}
+		foreach (KeyValuePair<int, MainState> state in states)
+		{
+			for (int depth = 2; depth < liveDepth && depth <= stack.Length; depth += 2)
+			{
+				if (BitConverter.ToInt16(stack, stack.Length - depth) == state.Key)
+				{
+					iIndex = stack.Length - depth;
+					return state.Value;
+				}
+			}
+		}
+		return MainState.Unknown;
+	}
+
 	public override GameState GetGameState()
 	{
 		return ReadBT123GameState();
