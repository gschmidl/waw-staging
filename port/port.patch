diff --git a/Staging/BiosKeyboard.cs b/Staging/BiosKeyboard.cs
new file mode 100644
index 0000000000000000000000000000000000000000..3ebe0bcac24a8db09d602356ed616aabbbfe225a
--- /dev/null
+++ b/Staging/BiosKeyboard.cs
@@ -0,0 +1,309 @@
+// Keys for DOSBox without a window to post to (macOS, Linux, or Staging's window not found on Windows):
+// WM_KEYDOWN/WM_KEYUP messages that Where Are We? posts to the stand-in DOSBox window are turned into BIOS
+// keystrokes (scan code + ASCII, US layout) appended to the BIOS keyboard buffer through the API. Programs
+// that read the keyboard with INT 16h see them as typed keys; programs with their own INT 9 handler don't.
+
+using System;
+using System.Threading;
+
+namespace WhereAreWe;
+
+public static class BiosKeyboard
+{
+	private const int WM_KEYDOWN = 256;
+
+	private const int WM_KEYUP = 257;
+
+	private const int WM_SYSKEYDOWN = 260;
+
+	private const int WM_SYSKEYUP = 261;
+
+	private const int BufferHead = 0x41A;
+
+	private const int BufferTail = 0x41C;
+
+	private const int BufferStart = 0x1E;
+
+	private const int BufferEnd = 0x3E;
+
+	private static bool s_shift;
+
+	private static bool s_ctrl;
+
+	private static bool s_alt;
+
+	private static readonly object s_lock = new object();
+
+	/// <summary>Handle a key message posted to the stand-in window; true if a keystroke was queued.</summary>
+	public static bool Post(int msg, IntPtr wParam, IntPtr lParam)
+	{
+		int vk = (int)wParam.ToInt64() & 0xFF;
+		bool down = msg == WM_KEYDOWN || msg == WM_SYSKEYDOWN;
+		if (!down && msg != WM_KEYUP && msg != WM_SYSKEYUP)
+		{
+			return false;
+		}
+		lock (s_lock)
+		{
+			switch (vk)
+			{
+			case 16:
+			case 160:
+			case 161:
+				s_shift = down;
+				return true;
+			case 17:
+			case 162:
+			case 163:
+				s_ctrl = down;
+				return true;
+			case 18:
+			case 164:
+			case 165:
+				s_alt = down;
+				return true;
+			}
+			if (!down)
+			{
+				return true;
+			}
+			if (!Translate(vk, s_shift, s_ctrl, s_alt, out int scan, out int ascii))
+			{
+				return false;
+			}
+			return Push(scan, ascii);
+		}
+	}
+
+	/// <summary>Append one keystroke to the BIOS buffer, waiting up to a second while it is full.</summary>
+	public static bool Push(int scan, int ascii)
+	{
+		byte[] pointers = new byte[4];
+		for (int attempt = 0; attempt < 50; attempt++)
+		{
+			if (!DosboxApi.ReadUncached(BufferHead, pointers, 0, 4))
+			{
+				return false;
+			}
+			int head = pointers[0] | (pointers[1] << 8);
+			int tail = pointers[2] | (pointers[3] << 8);
+			if (tail < BufferStart || tail >= BufferEnd || (tail & 1) != 0)
+			{
+				return false;
+			}
+			int next = tail + 2 >= BufferEnd ? BufferStart : tail + 2;
+			if (next != head)
+			{
+				if (!DosboxApi.Write(0x400 + tail, new byte[2]
+				{
+					(byte)ascii,
+					(byte)scan
+				}, 0, 2))
+				{
+					return false;
+				}
+				return DosboxApi.Write(BufferTail, new byte[2]
+				{
+					(byte)next,
+					(byte)(next >> 8)
+				}, 0, 2);
+			}
+			Thread.Sleep(20);
+		}
+		return false;
+	}
+
+	private static readonly int[] LetterScan = new int[26]
+	{
+		0x1E, 0x30, 0x2E, 0x20, 0x12, 0x21, 0x22, 0x23, 0x17, 0x24,
+		0x25, 0x26, 0x32, 0x31, 0x18, 0x19, 0x10, 0x13, 0x1F, 0x14,
+		0x16, 0x2F, 0x11, 0x2D, 0x15, 0x2C
+	};
+
+	private const string DigitShifted = ")!@#$%^&*(";
+
+	/// <summary>BIOS scan code and ASCII for a Windows virtual key with the given modifiers (US layout).</summary>
+	public static bool Translate(int vk, bool shift, bool ctrl, bool alt, out int scan, out int ascii)
+	{
+		scan = 0;
+		ascii = 0;
+		if (vk >= 65 && vk <= 90)
+		{
+			int i = vk - 65;
+			scan = LetterScan[i];
+			ascii = alt ? 0 : (ctrl ? (i + 1) : (shift ? (65 + i) : (97 + i)));
+			return true;
+		}
+		if (vk >= 48 && vk <= 57)
+		{
+			int d = vk - 48;
+			scan = d == 0 ? 0x0B : 1 + d;
+			if (alt)
+			{
+				scan = d == 0 ? 0x81 : 0x77 + d;
+				ascii = 0;
+			}
+			else
+			{
+				ascii = shift ? DigitShifted[d] : 48 + d;
+			}
+			return true;
+		}
+		if (vk >= 96 && vk <= 105)
+		{
+			int[] numScan = new int[10] { 0x52, 0x4F, 0x50, 0x51, 0x4B, 0x4C, 0x4D, 0x47, 0x48, 0x49 };
+			scan = numScan[vk - 96];
+			ascii = 48 + vk - 96;
+			return true;
+		}
+		if (vk >= 112 && vk <= 121)
+		{
+			int f = vk - 112;
+			scan = (alt ? 0x68 : (ctrl ? 0x5E : (shift ? 0x54 : 0x3B))) + f;
+			return true;
+		}
+		switch (vk)
+		{
+		case 122:
+			scan = alt ? 0x8B : (ctrl ? 0x89 : (shift ? 0x87 : 0x85));
+			return true;
+		case 123:
+			scan = alt ? 0x8C : (ctrl ? 0x8A : (shift ? 0x88 : 0x86));
+			return true;
+		case 13:
+			scan = 0x1C;
+			ascii = ctrl ? 10 : 13;
+			return true;
+		case 27:
+			scan = 0x01;
+			ascii = 27;
+			return true;
+		case 32:
+			scan = 0x39;
+			ascii = 32;
+			return true;
+		case 9:
+			scan = 0x0F;
+			ascii = shift ? 0 : 9;
+			return true;
+		case 8:
+			scan = 0x0E;
+			ascii = ctrl ? 127 : 8;
+			return true;
+		case 38:
+			scan = ctrl ? 0x8D : 0x48;
+			return true;
+		case 40:
+			scan = ctrl ? 0x91 : 0x50;
+			return true;
+		case 37:
+			scan = ctrl ? 0x73 : 0x4B;
+			return true;
+		case 39:
+			scan = ctrl ? 0x74 : 0x4D;
+			return true;
+		case 36:
+			scan = ctrl ? 0x77 : 0x47;
+			return true;
+		case 35:
+			scan = ctrl ? 0x75 : 0x4F;
+			return true;
+		case 33:
+			scan = ctrl ? 0x84 : 0x49;
+			return true;
+		case 34:
+			scan = ctrl ? 0x76 : 0x51;
+			return true;
+		case 45:
+			scan = 0x52;
+			return true;
+		case 46:
+			scan = 0x53;
+			return true;
+		case 106:
+			scan = 0x37;
+			ascii = 42;
+			return true;
+		case 107:
+			scan = 0x4E;
+			ascii = 43;
+			return true;
+		case 109:
+			scan = 0x4A;
+			ascii = 45;
+			return true;
+		case 110:
+			scan = 0x53;
+			ascii = 46;
+			return true;
+		case 111:
+			scan = 0x35;
+			ascii = 47;
+			return true;
+		}
+		string plain;
+		string shifted;
+		switch (vk)
+		{
+		case 186:
+			scan = 0x27;
+			plain = ";";
+			shifted = ":";
+			break;
+		case 187:
+			scan = 0x0D;
+			plain = "=";
+			shifted = "+";
+			break;
+		case 188:
+			scan = 0x33;
+			plain = ",";
+			shifted = "<";
+			break;
+		case 189:
+			scan = 0x0C;
+			plain = "-";
+			shifted = "_";
+			break;
+		case 190:
+			scan = 0x34;
+			plain = ".";
+			shifted = ">";
+			break;
+		case 191:
+			scan = 0x35;
+			plain = "/";
+			shifted = "?";
+			break;
+		case 192:
+			scan = 0x29;
+			plain = "`";
+			shifted = "~";
+			break;
+		case 219:
+			scan = 0x1A;
+			plain = "[";
+			shifted = "{";
+			break;
+		case 220:
+			scan = 0x2B;
+			plain = "\\";
+			shifted = "|";
+			break;
+		case 221:
+			scan = 0x1B;
+			plain = "]";
+			shifted = "}";
+			break;
+		case 222:
+			scan = 0x28;
+			plain = "'";
+			shifted = "\"";
+			break;
+		default:
+			return false;
+		}
+		ascii = alt ? 0 : (shift ? shifted[0] : plain[0]);
+		return true;
+	}
+}
diff --git a/Staging/DosboxApi.cs b/Staging/DosboxApi.cs
new file mode 100644
index 0000000000000000000000000000000000000000..9b1fc062fc7bc4dbe94248ec0dff94f53e8ba20c
--- /dev/null
+++ b/Staging/DosboxApi.cs
@@ -0,0 +1,781 @@
+// DOSBox Staging HTTP API access for the Where Are We? port.
+//
+// Where Are We? originally read and wrote DOSBox's process memory (ReadProcessMemory etc.). This port
+// talks to DOSBox Staging's built-in web server instead (Staging 0.83+, [webserver] webserver_enabled = on),
+// so it works on every platform and with any DOSBox Staging build that has the API.
+//
+// The rest of the program still sees a "process" with one committed memory region: the region starts
+// BlockHeader bytes before guest linear address 0, exactly like the heap block that holds the emulated
+// RAM in DOSBox 0.74 (the layout Where Are We?'s hard-coded offsets assume).
+
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.IO;
+using System.Net;
+using System.Net.Sockets;
+using System.Text;
+using System.Text.RegularExpressions;
+using System.Threading;
+
+namespace WhereAreWe;
+
+public static class DosboxApi
+{
+	/// <summary>Virtual address of the emulated-RAM region in the pseudo process.</summary>
+	public const ulong VirtualBase = 0x10000000uL;
+
+	/// <summary>Bytes between the region start and guest linear address 0 (DOSBox 0.74's heap block header).</summary>
+	public const int BlockHeader = 32;
+
+	/// <summary>Pseudo process id and handle for the DOSBox reached through the API.</summary>
+	public const int PseudoPid = 0x57A6;
+
+	public static readonly IntPtr ProcessHandle = new IntPtr(0x57A60);
+
+	/// <summary>Stand-in window handle where the real DOSBox window is unknown (not Windows, or not found).</summary>
+	public static readonly IntPtr PseudoWindow = new IntPtr(0x57A64);
+
+	public static readonly int[] DefaultPorts = { 8086, 8080 };
+
+	private const int PageSize = 0x10000;
+
+	private const int CacheMilliseconds = 50;
+
+	private const int BusyMilliseconds = 1000;
+
+	private const int AliveMilliseconds = 1000;
+
+	private static readonly object s_lock = new object();
+
+	private static readonly Dictionary<long, Page> s_pages = new Dictionary<long, Page>();
+
+	private static TcpClient s_client;
+
+	private static Stream s_stream;
+
+	private static string s_host = "127.0.0.1";
+
+	private static int s_port;
+
+	private static long s_ramSize;
+
+	private static int s_lastContact = int.MinValue;
+
+	private static int s_lastProbe = int.MinValue;
+
+	private static bool s_alive;
+
+	private static string s_version = "";
+
+	private sealed class Page
+	{
+		public byte[] Data;
+
+		public int Tick;
+	}
+
+	private sealed class Response
+	{
+		public int Status;
+
+		public byte[] Body;
+
+		public string Text => Encoding.UTF8.GetString(Body);
+	}
+
+	/// <summary>"host:port" to use, or null/empty to probe 127.0.0.1 on the default ports.
+	/// The WAW_DOSBOX_API environment variable overrides it.</summary>
+	public static string Address
+	{
+		get
+		{
+			return s_address;
+		}
+		set
+		{
+			lock (s_lock)
+			{
+				if (value != s_address)
+				{
+					s_address = value;
+					Close();
+					s_alive = false;
+					s_lastProbe = int.MinValue;
+					s_pages.Clear();
+				}
+			}
+		}
+	}
+
+	private static string s_address;
+
+	public static string Version => s_version;
+
+	public static int Port => s_port;
+
+	public static long RamSize => s_ramSize;
+
+	public static ulong RegionSize => (ulong)(BlockHeader + s_ramSize);
+
+	public static string LastError { get; private set; } = "";
+
+	/// <summary>True while a DOSBox Staging API answers; probes again at most once per second.</summary>
+	public static bool IsAlive
+	{
+		get
+		{
+			lock (s_lock)
+			{
+				if (s_alive && Elapsed(s_lastContact) < AliveMilliseconds)
+				{
+					return true;
+				}
+				if (!s_alive && Elapsed(s_lastProbe) < AliveMilliseconds)
+				{
+					return false;
+				}
+				return Connect();
+			}
+		}
+	}
+
+	private static int Elapsed(int tick)
+	{
+		return tick == int.MinValue ? int.MaxValue : unchecked(Environment.TickCount - tick);
+	}
+
+	private static List<KeyValuePair<string, int>> Candidates()
+	{
+		List<KeyValuePair<string, int>> list = new List<KeyValuePair<string, int>>();
+		string text = Environment.GetEnvironmentVariable("WAW_DOSBOX_API");
+		if (string.IsNullOrWhiteSpace(text))
+		{
+			text = Address;
+		}
+		if (!string.IsNullOrWhiteSpace(text))
+		{
+			text = text.Trim();
+			Match match = Regex.Match(text, "^(?:https?://)?(\\[[^\\]]+\\]|[^:/]+)?(?::(\\d+))?/?$");
+			if (match.Success)
+			{
+				string host = match.Groups[1].Success && match.Groups[1].Value != "" ? match.Groups[1].Value.Trim('[', ']') : "127.0.0.1";
+				if (match.Groups[2].Success)
+				{
+					list.Add(new KeyValuePair<string, int>(host, int.Parse(match.Groups[2].Value, CultureInfo.InvariantCulture)));
+					return list;
+				}
+				foreach (int port in DefaultPorts)
+				{
+					list.Add(new KeyValuePair<string, int>(host, port));
+				}
+				return list;
+			}
+		}
+		if (s_port != 0)
+		{
+			list.Add(new KeyValuePair<string, int>(s_host, s_port));
+		}
+		foreach (int port in DefaultPorts)
+		{
+			if (port != s_port || s_host != "127.0.0.1")
+			{
+				list.Add(new KeyValuePair<string, int>("127.0.0.1", port));
+			}
+		}
+		return list;
+	}
+
+	/// <summary>Connected, or connected now; while nothing answers, at most one attempt per second (caller holds the
+	/// lock). Every read would otherwise try again, and the UI thread reads many times per refresh: with DOSBox gone,
+	/// Where Are We? hung for seconds at a time and quit 6 s late.</summary>
+	private static bool EnsureConnected()
+	{
+		if (s_alive)
+		{
+			return true;
+		}
+		if (Elapsed(s_lastProbe) < AliveMilliseconds)
+		{
+			return false;
+		}
+		return Connect();
+	}
+
+	/// <summary>Windows takes 2 s to refuse a connection to a closed local port (it retries the SYN), while a
+	/// listening one connects at once: a local address gets a short wait.</summary>
+	private static int ConnectWait(int timeoutMs)
+	{
+		bool loopback = s_host == "localhost" || (IPAddress.TryParse(s_host, out IPAddress address) && IPAddress.IsLoopback(address));
+		return loopback ? Math.Min(timeoutMs, 50) : timeoutMs;
+	}
+
+	/// <summary>Find a DOSBox Staging API (caller holds the lock).</summary>
+	private static bool Connect()
+	{
+		s_lastProbe = Environment.TickCount;
+		foreach (KeyValuePair<string, int> candidate in Candidates())
+		{
+			Close();
+			s_host = candidate.Key;
+			s_port = candidate.Value;
+			Response response = Send("GET", "/api/v1/dosbox/info", null, 300);
+			if (response == null || response.Status != 200)
+			{
+				continue;
+			}
+			Match match = Regex.Match(response.Text, "\"version\"\\s*:\\s*\"((?:[^\"\\\\]|\\\\.)*)\"");
+			if (!match.Success)
+			{
+				continue;
+			}
+			string version = match.Groups[1].Value;
+			long ramSize = ProbeRamSize();
+			if (ramSize <= 0)
+			{
+				continue;
+			}
+			if (version != s_version || ramSize != s_ramSize)
+			{
+				s_pages.Clear();
+			}
+			s_version = version;
+			s_ramSize = ramSize;
+			s_alive = true;
+			s_lastContact = Environment.TickCount;
+			Global.Log("DOSBox API: {0} at {1}:{2}, {3} bytes of RAM", version, s_host, s_port, ramSize);
+			return true;
+		}
+		Close();
+		if (s_alive)
+		{
+			Global.LogWarning("DOSBox API: connection lost");
+		}
+		s_alive = false;
+		s_pages.Clear();
+		return false;
+	}
+
+	/// <summary>Emulated RAM size: Staging refuses reads past the end and names the size in the error.</summary>
+	private static long ProbeRamSize()
+	{
+		Response response = Send("GET", "/api/v1/memory/" + 0x7FFFFFFF + "/1", null, 1000);
+		if (response == null)
+		{
+			return -1L;
+		}
+		Match match = Regex.Match(response.Text, "memory size \\((\\d+) bytes\\)");
+		if (match.Success)
+		{
+			return long.Parse(match.Groups[1].Value, CultureInfo.InvariantCulture);
+		}
+		long low = 0x100000L;
+		long high = 0x7FFFFFFFL;
+		if (!ReadsAt(low - 1))
+		{
+			return -1L;
+		}
+		while (high - low > 1)
+		{
+			long mid = (low + high) / 2;
+			if (ReadsAt(mid - 1))
+			{
+				low = mid;
+			}
+			else
+			{
+				high = mid;
+			}
+		}
+		return low;
+	}
+
+	private static bool ReadsAt(long address)
+	{
+		Response response = Send("GET", "/api/v1/memory/" + address + "/1", null, 1000);
+		return response != null && response.Status == 200 && response.Body.Length == 1;
+	}
+
+	private static void Close()
+	{
+		try
+		{
+			s_stream?.Dispose();
+			s_client?.Close();
+		}
+		catch (Exception)
+		{
+		}
+		s_stream = null;
+		s_client = null;
+	}
+
+	/// <summary>One HTTP/1.1 exchange on the kept-alive connection; null if the server can't be reached.</summary>
+	private static Response Send(string method, string path, byte[] body, int timeoutMs, string extraHeaders = null)
+	{
+		for (int attempt = 0; attempt < 2; attempt++)
+		{
+			bool fresh = s_client == null;
+			try
+			{
+				if (s_client == null)
+				{
+					TcpClient client = new TcpClient(s_host.Contains(":") ? AddressFamily.InterNetworkV6 : AddressFamily.InterNetwork);
+					client.NoDelay = true;
+					IAsyncResult connect = client.BeginConnect(s_host, s_port, null, null);
+					if (!connect.AsyncWaitHandle.WaitOne(ConnectWait(timeoutMs)) || !client.Connected)
+					{
+						client.Close();
+						return null;
+					}
+					client.EndConnect(connect);
+					s_client = client;
+					s_stream = client.GetStream();
+				}
+				s_client.ReceiveTimeout = timeoutMs;
+				s_client.SendTimeout = timeoutMs;
+				string hostHeader = (s_host.Contains(":") ? "[" + s_host + "]" : s_host) + ":" + s_port;
+				StringBuilder request = new StringBuilder();
+				request.Append(method).Append(' ').Append(path).Append(" HTTP/1.1\r\n");
+				request.Append("Host: ").Append(hostHeader).Append("\r\n");
+				request.Append("Connection: keep-alive\r\n");
+				if (body != null)
+				{
+					request.Append("Content-Type: application/octet-stream\r\n");
+					request.Append("Content-Length: ").Append(body.Length).Append("\r\n");
+				}
+				if (extraHeaders != null)
+				{
+					request.Append(extraHeaders);
+				}
+				request.Append("\r\n");
+				byte[] head = Encoding.ASCII.GetBytes(request.ToString());
+				if (body != null && body.Length + head.Length <= 65536)
+				{
+					byte[] all = new byte[head.Length + body.Length];
+					Buffer.BlockCopy(head, 0, all, 0, head.Length);
+					Buffer.BlockCopy(body, 0, all, head.Length, body.Length);
+					s_stream.Write(all, 0, all.Length);
+				}
+				else
+				{
+					s_stream.Write(head, 0, head.Length);
+					if (body != null)
+					{
+						s_stream.Write(body, 0, body.Length);
+					}
+				}
+				s_stream.Flush();
+				return ReadResponse(method == "HEAD");
+			}
+			catch (Exception ex) when (ex is IOException || ex is SocketException || ex is ObjectDisposedException || ex is InvalidOperationException)
+			{
+				Close();
+				if (fresh)
+				{
+					return null;
+				}
+			}
+		}
+		return null;
+	}
+
+	private static Response ReadResponse(bool headOnly)
+	{
+		string statusLine = ReadLine();
+		Match status = Regex.Match(statusLine, "^HTTP/1\\.[01] (\\d{3})");
+		if (!status.Success)
+		{
+			throw new IOException("bad status line: " + statusLine);
+		}
+		int contentLength = -1;
+		bool chunked = false;
+		bool close = statusLine.StartsWith("HTTP/1.0", StringComparison.Ordinal);
+		string line;
+		while ((line = ReadLine()).Length > 0)
+		{
+			int colon = line.IndexOf(':');
+			if (colon <= 0)
+			{
+				continue;
+			}
+			string name = line.Substring(0, colon).Trim().ToLowerInvariant();
+			string value = line.Substring(colon + 1).Trim();
+			if (name == "content-length")
+			{
+				contentLength = int.Parse(value, CultureInfo.InvariantCulture);
+			}
+			else if (name == "transfer-encoding" && value.ToLowerInvariant().Contains("chunked"))
+			{
+				chunked = true;
+			}
+			else if (name == "connection" && value.ToLowerInvariant().Contains("close"))
+			{
+				close = true;
+			}
+		}
+		MemoryStream bodyStream = new MemoryStream();
+		if (!headOnly)
+		{
+			if (chunked)
+			{
+				while (true)
+				{
+					string sizeLine = ReadLine();
+					int semicolon = sizeLine.IndexOf(';');
+					int size = int.Parse(semicolon >= 0 ? sizeLine.Substring(0, semicolon) : sizeLine, NumberStyles.HexNumber, CultureInfo.InvariantCulture);
+					if (size == 0)
+					{
+						while (ReadLine().Length > 0)
+						{
+						}
+						break;
+					}
+					ReadExactly(bodyStream, size);
+					ReadLine();
+				}
+			}
+			else if (contentLength >= 0)
+			{
+				ReadExactly(bodyStream, contentLength);
+			}
+			else
+			{
+				s_stream.CopyTo(bodyStream);
+				close = true;
+			}
+		}
+		if (close)
+		{
+			Close();
+		}
+		return new Response
+		{
+			Status = int.Parse(status.Groups[1].Value, CultureInfo.InvariantCulture),
+			Body = bodyStream.ToArray()
+		};
+	}
+
+	private static string ReadLine()
+	{
+		StringBuilder line = new StringBuilder();
+		while (true)
+		{
+			int b = s_stream.ReadByte();
+			if (b < 0)
+			{
+				throw new IOException("connection closed");
+			}
+			if (b == '\n')
+			{
+				break;
+			}
+			if (b != '\r')
+			{
+				line.Append((char)b);
+			}
+		}
+		return line.ToString();
+	}
+
+	private static void ReadExactly(MemoryStream target, int count)
+	{
+		byte[] buffer = new byte[Math.Min(count, 65536)];
+		while (count > 0)
+		{
+			int read = s_stream.Read(buffer, 0, Math.Min(buffer.Length, count));
+			if (read <= 0)
+			{
+				throw new IOException("connection closed");
+			}
+			target.Write(buffer, 0, read);
+			count -= read;
+		}
+	}
+
+	/// <summary>A request on the live connection; marks the server dead when it can't be reached.</summary>
+	private static Response Request(string method, string path, byte[] body = null, string extraHeaders = null)
+	{
+		if (!EnsureConnected())
+		{
+			return null;
+		}
+		Response response = Send(method, path, body, 2000, extraHeaders);
+		if (response == null)
+		{
+			s_alive = false;
+			s_lastProbe = Environment.TickCount;
+			s_pages.Clear();
+			Global.LogWarning("DOSBox API: request failed, connection lost");
+			return null;
+		}
+		s_lastContact = Environment.TickCount;
+		return response;
+	}
+
+	private static bool IsBusy(Response response)
+	{
+		return response != null && response.Status >= 500 && response.Text.IndexOf("timeout", StringComparison.OrdinalIgnoreCase) >= 0;
+	}
+
+	/// <summary>Fetch one cache page; while DOSBox is busy (e.g. its window is being dragged) an older copy is served.</summary>
+	private static Page GetPage(long pageStart)
+	{
+		s_pages.TryGetValue(pageStart, out Page page);
+		if (page != null && Elapsed(page.Tick) < CacheMilliseconds)
+		{
+			return page;
+		}
+		int length = (int)Math.Min(PageSize, s_ramSize - pageStart);
+		if (length <= 0)
+		{
+			return null;
+		}
+		Response response = Request("GET", "/api/v1/memory/" + pageStart + "/" + length);
+		if (response != null && response.Status == 200 && response.Body.Length == length)
+		{
+			page = new Page { Data = response.Body, Tick = Environment.TickCount };
+			s_pages[pageStart] = page;
+			return page;
+		}
+		if (IsBusy(response) && page != null && Elapsed(page.Tick) < BusyMilliseconds)
+		{
+			return page;
+		}
+		if (response != null && response.Status != 200)
+		{
+			LastError = response.Text;
+		}
+		return null;
+	}
+
+	/// <summary>Read guest RAM at a linear address; false (nothing copied) if any part is unavailable.</summary>
+	public static bool Read(long linear, byte[] buffer, int offset, int count)
+	{
+		if (count == 0)
+		{
+			return true;
+		}
+		lock (s_lock)
+		{
+			if ((!EnsureConnected()) || linear < 0 || linear + count > s_ramSize)
+			{
+				return false;
+			}
+			int done = 0;
+			while (done < count)
+			{
+				long address = linear + done;
+				long pageStart = address - address % PageSize;
+				Page page = GetPage(pageStart);
+				if (page == null)
+				{
+					return false;
+				}
+				int inPage = (int)(address - pageStart);
+				int n = Math.Min(count - done, page.Data.Length - inPage);
+				Buffer.BlockCopy(page.Data, inPage, buffer, offset + done, n);
+				done += n;
+			}
+			return true;
+		}
+	}
+
+	/// <summary>Write guest RAM at a linear address; the cache sees the new bytes at once.</summary>
+	public static bool Write(long linear, byte[] buffer, int offset, int count)
+	{
+		if (count == 0)
+		{
+			return true;
+		}
+		lock (s_lock)
+		{
+			if ((!EnsureConnected()) || linear < 0 || linear + count > s_ramSize)
+			{
+				return false;
+			}
+			byte[] body = buffer;
+			if (offset != 0 || count != buffer.Length)
+			{
+				body = new byte[count];
+				Buffer.BlockCopy(buffer, offset, body, 0, count);
+			}
+			Response response = null;
+			for (int attempt = 0; attempt < 8; attempt++)
+			{
+				response = Request("PUT", "/api/v1/memory/" + linear, body);
+				if (!IsBusy(response))
+				{
+					break;
+				}
+				Thread.Sleep(50);
+			}
+			if (response == null || response.Status / 100 != 2)
+			{
+				if (response != null)
+				{
+					LastError = response.Text;
+				}
+				return false;
+			}
+			for (long pageStart = linear - linear % PageSize; pageStart < linear + count; pageStart += PageSize)
+			{
+				if (s_pages.TryGetValue(pageStart, out Page page))
+				{
+					long from = Math.Max(linear, pageStart);
+					long to = Math.Min(linear + count, pageStart + page.Data.Length);
+					Buffer.BlockCopy(body, (int)(from - linear), page.Data, (int)(from - pageStart), (int)(to - from));
+				}
+			}
+			return true;
+		}
+	}
+
+	/// <summary>Read guest RAM bypassing the cache (for values the emulated program changes all the time).</summary>
+	public static bool ReadUncached(long linear, byte[] buffer, int offset, int count)
+	{
+		lock (s_lock)
+		{
+			if ((!EnsureConnected()) || linear < 0 || linear + count > s_ramSize)
+			{
+				return false;
+			}
+			Response response = Request("GET", "/api/v1/memory/" + linear + "/" + count);
+			if (response == null || response.Status != 200 || response.Body.Length != count)
+			{
+				return false;
+			}
+			Buffer.BlockCopy(response.Body, 0, buffer, offset, count);
+			return true;
+		}
+	}
+
+	/// <summary>Forget cached memory, e.g. before a scan that must see fresh bytes.</summary>
+	public static void Invalidate()
+	{
+		lock (s_lock)
+		{
+			s_pages.Clear();
+		}
+	}
+
+	private static long JsonNumber(string json, string name)
+	{
+		Match match = Regex.Match(json, "\"" + name + "\"\\s*:\\s*(\\d+)");
+		return match.Success ? long.Parse(match.Groups[1].Value, CultureInfo.InvariantCulture) : -1L;
+	}
+
+	/// <summary>The emulated CPU's stack pointer as a linear address (SS*16 + SP, real mode), from /api/v1/cpu/state;
+	/// false if it can't be had.</summary>
+	public static bool StackPointer(out long linear)
+	{
+		linear = 0L;
+		lock (s_lock)
+		{
+			Response response = Request("GET", "/api/v1/cpu/state");
+			if (response == null || response.Status != 200)
+			{
+				return false;
+			}
+			long ss = JsonNumber(response.Text, "ss");
+			long esp = JsonNumber(response.Text, "esp");
+			if (ss < 0 || esp < 0)
+			{
+				return false;
+			}
+			linear = ss * 16 + (esp & 0xFFFF);
+			return true;
+		}
+	}
+
+	/// <summary>Name of the program DOS is running (the MCB name of the current PSP), "" if unknown.</summary>
+	public static string RunningProgram()
+	{
+		lock (s_lock)
+		{
+			Response response = Request("GET", "/api/v1/dos/internals");
+			if (response == null || response.Status != 200)
+			{
+				return "";
+			}
+			long sda = JsonNumber(response.Text, "dosSwappableArea");
+			byte[] psp = new byte[2];
+			if (sda < 0 || !Read(sda + 0x10, psp, 0, 2))
+			{
+				return "";
+			}
+			int segment = psp[0] | (psp[1] << 8);
+			byte[] name = new byte[8];
+			if (segment == 0 || !Read((long)(segment - 1) * 16 + 8, name, 0, 8))
+			{
+				return "";
+			}
+			StringBuilder text = new StringBuilder();
+			foreach (byte b in name)
+			{
+				if (b == 0)
+				{
+					break;
+				}
+				text.Append(b >= 32 && b < 127 ? (char)b : '?');
+			}
+			return text.ToString();
+		}
+	}
+
+	/// <summary>Full path of the program that started the one whose PSP is at the given linear address
+	/// (the parent PSP's environment block names it), "" if unknown.</summary>
+	public static string ParentProgram(long pspLinear)
+	{
+		lock (s_lock)
+		{
+			byte[] word = new byte[2];
+			if (!Read(pspLinear + 0x16, word, 0, 2))
+			{
+				return "";
+			}
+			int parent = word[0] | (word[1] << 8);
+			if (parent == 0 || !Read((long)parent * 16 + 0x2C, word, 0, 2))
+			{
+				return "";
+			}
+			return EnvironmentProgram(word[0] | (word[1] << 8));
+		}
+	}
+
+	/// <summary>The program path stored after the variables of a DOS environment block.</summary>
+	public static string EnvironmentProgram(int envSegment)
+	{
+		byte[] env = new byte[1024];
+		if (envSegment == 0 || !Read((long)envSegment * 16, env, 0, env.Length))
+		{
+			return "";
+		}
+		for (int i = 0; i + 3 < env.Length; i++)
+		{
+			if (env[i] == 0 && env[i + 1] == 0)
+			{
+				StringBuilder path = new StringBuilder();
+				for (int j = i + 4; j < env.Length && env[j] != 0; j++)
+				{
+					path.Append((char)env[j]);
+				}
+				return path.ToString();
+			}
+		}
+		return "";
+	}
+
+	/// <summary>A DOSBox 0.74-style title naming the running program, which the per-game title patterns match.</summary>
+	public static string WindowTitle
+	{
+		get
+		{
+			if (!IsAlive)
+			{
+				return "";
+			}
+			return "DOSBox 0.74, Cpu speed:     3000 cycles, Frameskip  0, Program: " + RunningProgram().PadLeft(8);
+		}
+	}
+}
diff --git a/Staging/DosboxProcess.cs b/Staging/DosboxProcess.cs
new file mode 100644
index 0000000000000000000000000000000000000000..1baca8549726b148c0165a11466ea6d82522ef53
--- /dev/null
+++ b/Staging/DosboxProcess.cs
@@ -0,0 +1,38 @@
+// Stand-in for the System.Diagnostics.Process of a DOSBox that Where Are We? used to open: the DOSBox
+// Staging instance reachable through its HTTP API (see DosboxApi).
+
+using System;
+
+namespace WhereAreWe;
+
+public sealed class DosboxProcess
+{
+	private static readonly DosboxProcess s_instance = new DosboxProcess();
+
+	private DosboxProcess()
+	{
+	}
+
+	/// <summary>The API's DOSBox as a one-element array, or null when no API answers (like GetProcessesByName finding nothing).</summary>
+	public static DosboxProcess[] GetAll()
+	{
+		if (!DosboxApi.IsAlive)
+		{
+			return null;
+		}
+		return new DosboxProcess[1] { s_instance };
+	}
+
+	public int Id => DosboxApi.PseudoPid;
+
+	public IntPtr Handle => DosboxApi.ProcessHandle;
+
+	public bool HasExited => !DosboxApi.IsAlive;
+
+	public string MainWindowTitle => DosboxApi.WindowTitle;
+
+	public override string ToString()
+	{
+		return $"DOSBox Staging API {DosboxApi.Version} on port {DosboxApi.Port}";
+	}
+}
diff --git a/Staging/DosboxWindow.cs b/Staging/DosboxWindow.cs
new file mode 100644
index 0000000000000000000000000000000000000000..55e187f0faa5cd80fb2eaacff10abea3510877e1
--- /dev/null
+++ b/Staging/DosboxWindow.cs
@@ -0,0 +1,152 @@
+// The DOSBox window for the Where Are We? port.
+//
+// On Windows this is DOSBox Staging's real top-level window (the process that owns the API's listening
+// port), so focusing, positioning and posting keys to it work as in the original. Elsewhere, or when it
+// can't be found, a stand-in handle represents it and NativeMethods answers for it.
+
+using System;
+using System.Runtime.InteropServices;
+
+namespace WhereAreWe;
+
+public static class DosboxWindow
+{
+	private static IntPtr s_hwnd = IntPtr.Zero;
+
+	private static int s_port;
+
+	/// <summary>True for the stand-in handle and for the real DOSBox window found last.</summary>
+	public static bool IsDosbox(IntPtr hWnd)
+	{
+		if (hWnd != IntPtr.Zero)
+		{
+			if (!(hWnd == DosboxApi.PseudoWindow))
+			{
+				return hWnd == s_hwnd;
+			}
+			return true;
+		}
+		return false;
+	}
+
+	/// <summary>The DOSBox window, the stand-in handle, or IntPtr.Zero when no DOSBox Staging API answers.</summary>
+	public static IntPtr Find()
+	{
+		if (!DosboxApi.IsAlive)
+		{
+			s_hwnd = IntPtr.Zero;
+			return IntPtr.Zero;
+		}
+		if (!NativeMethods.Win32)
+		{
+			return DosboxApi.PseudoWindow;
+		}
+		if (s_hwnd != IntPtr.Zero && s_port == DosboxApi.Port && NativeMethods.IsWindow(s_hwnd))
+		{
+			return s_hwnd;
+		}
+		s_hwnd = IntPtr.Zero;
+		s_port = DosboxApi.Port;
+		try
+		{
+			// WAW's DOSBoxClass setting (default ^SDL_App$) never took part in its window search (WindowFinder
+			// doesn't store the class pattern), so it isn't used here either: the pid identifies the window.
+			// The process also owns Windows' text input indicator (UAC_InputIndicatorOverlayWnd and
+			// "UAC Input Indicator": visible, topmost, no-activate, 47x47 in the screen corner), which
+			// comes first in z-order: only a window that can be activated counts, SDL's own window first.
+			int pid = ListeningPid(DosboxApi.Port);
+			if (pid > 0)
+			{
+				IntPtr first = IntPtr.Zero;
+				NativeMethods.EnumWindows(delegate(IntPtr hWnd, IntPtr lParam)
+				{
+					NativeMethods.GetWindowThreadProcessId(hWnd, out var processId);
+					if (processId == pid && NativeMethods.IsWindowVisible(hWnd) && NativeMethods.GetWindow(hWnd, NativeMethods.GetWindow_Cmd.GW_OWNER) == IntPtr.Zero && CanActivate(hWnd))
+					{
+						if (string.Equals(NativeMethods.GetClassName(hWnd), "SDL_app", StringComparison.OrdinalIgnoreCase))
+						{
+							s_hwnd = hWnd;
+							return false;
+						}
+						if (first == IntPtr.Zero)
+						{
+							first = hWnd;
+						}
+					}
+					return true;
+				}, IntPtr.Zero);
+				if (s_hwnd == IntPtr.Zero)
+				{
+					s_hwnd = first;
+				}
+			}
+		}
+		catch (Exception ex)
+		{
+			Global.LogWarning("DOSBox window lookup failed: " + ex.Message);
+		}
+		if (!(s_hwnd != IntPtr.Zero))
+		{
+			return DosboxApi.PseudoWindow;
+		}
+		return s_hwnd;
+	}
+
+	private const int WS_DISABLED = 0x08000000;
+
+	private const int WS_EX_TOOLWINDOW = 0x80;
+
+	private static bool CanActivate(IntPtr hWnd)
+	{
+		int style = NativeMethods.GetWindowLong(hWnd, -16);
+		int exStyle = NativeMethods.GetWindowLong(hWnd, NativeMethods.GWL_EXSTYLE);
+		return (style & WS_DISABLED) == 0 && (exStyle & (NativeMethods.WS_EX_NOACTIVATE | WS_EX_TOOLWINDOW)) == 0;
+	}
+
+	private const int AF_INET = 2;
+
+	private const int AF_INET6 = 23;
+
+	private const int TCP_TABLE_OWNER_PID_LISTENER = 3;
+
+	[DllImport("iphlpapi.dll", SetLastError = true)]
+	private static extern uint GetExtendedTcpTable(IntPtr pTcpTable, ref int dwOutBufLen, bool sort, int ipVersion, int tblClass, uint reserved);
+
+	/// <summary>Process id listening on a local TCP port (IPv4 or IPv6), 0 if none.</summary>
+	private static int ListeningPid(int port)
+	{
+		foreach (int family in new int[2] { AF_INET, AF_INET6 })
+		{
+			int size = 0;
+			GetExtendedTcpTable(IntPtr.Zero, ref size, sort: false, family, TCP_TABLE_OWNER_PID_LISTENER, 0u);
+			IntPtr table = Marshal.AllocHGlobal(size);
+			try
+			{
+				if (GetExtendedTcpTable(table, ref size, sort: false, family, TCP_TABLE_OWNER_PID_LISTENER, 0u) != 0)
+				{
+					continue;
+				}
+				int rows = Marshal.ReadInt32(table);
+				// MIB_TCPROW_OWNER_PID: state, local addr, local port, remote addr, remote port, pid (6 DWORDs)
+				// MIB_TCP6ROW_OWNER_PID: local addr[16], scope, local port, remote addr[16], scope, remote port, state, pid
+				int rowSize = family == AF_INET ? 24 : 56;
+				int portOffset = family == AF_INET ? 8 : 20;
+				int pidOffset = family == AF_INET ? 20 : 52;
+				for (int i = 0; i < rows; i++)
+				{
+					IntPtr row = IntPtr.Add(table, 4 + i * rowSize);
+					int rowPort = Marshal.ReadByte(row, portOffset) << 8 | Marshal.ReadByte(row, portOffset + 1);
+					if (rowPort == port)
+					{
+						return Marshal.ReadInt32(row, pidOffset);
+					}
+				}
+			}
+			finally
+			{
+				Marshal.FreeHGlobal(table);
+			}
+		}
+		return 0;
+	}
+}
diff --git a/Staging/PortableSettings.cs b/Staging/PortableSettings.cs
new file mode 100644
index 0000000000000000000000000000000000000000..5defaef5d5b7fe477d3fdae4a903832cc08ee66f
--- /dev/null
+++ b/Staging/PortableSettings.cs
@@ -0,0 +1,199 @@
+// Portable settings: when a file named WhereAreWe.settings sits next to WhereAreWe.exe, Where Are We? keeps its
+// settings in that file (XML) instead of the user's profile, and its autosave file next to it instead of %TEMP%.
+// That keeps a copy installed in a portable collection (eXoDOS's util\WhereAreWe) self-contained. An empty file
+// works as the switch. Without the file the settings go where .NET puts them (LocalFileSettingsProvider).
+
+using System;
+using System.Collections.Generic;
+using System.Collections.Specialized;
+using System.Configuration;
+using System.IO;
+using System.Xml.Linq;
+
+namespace WhereAreWe;
+
+public sealed class PortableSettingsProvider : SettingsProvider, IApplicationSettingsProvider
+{
+	public const string FileName = "WhereAreWe.settings";
+
+	private const string AutoSaveDefault = "%TEMP%\\WhereAreWe-autosave.waw";
+
+	private const string ScriptsDumpDefault = "%TEMP%\\WAW_Scripts.txt";
+
+	private readonly LocalFileSettingsProvider m_local = new LocalFileSettingsProvider();
+
+	/// <summary>The settings file when running portable, else null.</summary>
+	public static string FilePath { get; private set; }
+
+	public override string ApplicationName
+	{
+		get
+		{
+			return m_local.ApplicationName;
+		}
+		set
+		{
+			m_local.ApplicationName = value;
+		}
+	}
+
+	/// <summary>Turns portable mode on if the settings file exists; call before the first use of the settings.</summary>
+	public static void Configure()
+	{
+		string path = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, FileName);
+		FilePath = File.Exists(path) ? path : null;
+	}
+
+	/// <summary>In portable mode, files that default to %TEMP% go next to the program instead.</summary>
+	public static void MoveTempFiles()
+	{
+		if (FilePath == null)
+		{
+			return;
+		}
+		string dir = Path.GetDirectoryName(FilePath);
+		if (Properties.Settings.Default.AutoSaveFile == AutoSaveDefault)
+		{
+			Properties.Settings.Default.AutoSaveFile = Path.Combine(dir, "WhereAreWe-autosave.waw");
+		}
+		if (Properties.Settings.Default.ScriptsDumpFile == ScriptsDumpDefault)
+		{
+			Properties.Settings.Default.ScriptsDumpFile = Path.Combine(dir, "WAW_Scripts.txt");
+		}
+	}
+
+	public override void Initialize(string name, NameValueCollection config)
+	{
+		base.Initialize(string.IsNullOrEmpty(name) ? nameof(PortableSettingsProvider) : name, config);
+		m_local.Initialize(null, null);
+	}
+
+	public override SettingsPropertyValueCollection GetPropertyValues(SettingsContext context, SettingsPropertyCollection collection)
+	{
+		if (FilePath == null)
+		{
+			return m_local.GetPropertyValues(context, collection);
+		}
+		Dictionary<string, XElement> stored = Load();
+		SettingsPropertyValueCollection values = new SettingsPropertyValueCollection();
+		foreach (SettingsProperty property in collection)
+		{
+			SettingsPropertyValue value = new SettingsPropertyValue(property);
+			if (stored.TryGetValue(property.Name, out XElement element))
+			{
+				if ((string)element.Attribute("binary") == "true")
+				{
+					value.SerializedValue = Convert.FromBase64String(element.Value);
+				}
+				else
+				{
+					value.SerializedValue = element.Value;
+				}
+			}
+			value.IsDirty = false;
+			values.Add(value);
+		}
+		return values;
+	}
+
+	public override void SetPropertyValues(SettingsContext context, SettingsPropertyValueCollection collection)
+	{
+		if (FilePath == null)
+		{
+			m_local.SetPropertyValues(context, collection);
+			return;
+		}
+		Dictionary<string, XElement> stored = Load();
+		foreach (SettingsPropertyValue value in collection)
+		{
+			if (!value.IsDirty && value.UsingDefaultValue)
+			{
+				continue;
+			}
+			object serialized = value.SerializedValue;
+			XElement element = new XElement("setting", new XAttribute("name", value.Name));
+			if (serialized is byte[] bytes)
+			{
+				element.Add(new XAttribute("binary", "true"), Convert.ToBase64String(bytes));
+			}
+			else if (serialized != null)
+			{
+				element.Add(serialized.ToString());
+			}
+			else
+			{
+				stored.Remove(value.Name);
+				continue;
+			}
+			stored[value.Name] = element;
+		}
+		Save(stored);
+	}
+
+	public SettingsPropertyValue GetPreviousVersion(SettingsContext context, SettingsProperty property)
+	{
+		if (FilePath == null)
+		{
+			return m_local.GetPreviousVersion(context, property);
+		}
+		return new SettingsPropertyValue(property);
+	}
+
+	public void Reset(SettingsContext context)
+	{
+		if (FilePath == null)
+		{
+			m_local.Reset(context);
+			return;
+		}
+		Save(new Dictionary<string, XElement>());
+	}
+
+	public void Upgrade(SettingsContext context, SettingsPropertyCollection properties)
+	{
+		if (FilePath == null)
+		{
+			m_local.Upgrade(context, properties);
+		}
+	}
+
+	private static Dictionary<string, XElement> Load()
+	{
+		Dictionary<string, XElement> stored = new Dictionary<string, XElement>();
+		try
+		{
+			if (new FileInfo(FilePath).Length == 0)
+			{
+				return stored;
+			}
+			foreach (XElement element in XDocument.Load(FilePath).Root.Elements("setting"))
+			{
+				string name = (string)element.Attribute("name");
+				if (name != null)
+				{
+					stored[name] = element;
+				}
+			}
+		}
+		catch (Exception ex) when (ex is IOException || ex is UnauthorizedAccessException || ex is System.Xml.XmlException)
+		{
+			Global.Log("Could not read {0}: {1}", FilePath, ex.Message);
+		}
+		return stored;
+	}
+
+	private static void Save(Dictionary<string, XElement> stored)
+	{
+		List<string> names = new List<string>(stored.Keys);
+		names.Sort(StringComparer.Ordinal);
+		XElement root = new XElement("WhereAreWe");
+		foreach (string name in names)
+		{
+			root.Add(stored[name]);
+		}
+		string temp = FilePath + ".tmp";
+		new XDocument(root).Save(temp);
+		File.Copy(temp, FilePath, overwrite: true);
+		File.Delete(temp);
+	}
+}
diff --git a/Staging/WinFormsSplitContainer.cs b/Staging/WinFormsSplitContainer.cs
new file mode 100644
index 0000000000000000000000000000000000000000..0dc887eadaaa6052aa007b0d58eabde820ecd9cd
--- /dev/null
+++ b/Staging/WinFormsSplitContainer.cs
@@ -0,0 +1,178 @@
+// Majorsilence.Forms build only: a SplitContainer that behaves like WinForms' where Where Are We? relies on it.
+// tools/build_msf.py makes every designer-created SplitContainer one of these; ScalableSplitContainer derives
+// from it.
+//  - Resizing: Majorsilence rescales the split from the previous size, so a clamp at a transient size (hidden
+//    tab pages and fresh controls are laid out at their default sizes first) loses the split for good: Party
+//    Information's quick-reference list ended up as a sliver at the right edge. WinForms remembers what the
+//    last SplitterDistance assignment asked for -- the ratio (FixedPanel.None) or the fixed panel's size --
+//    and recomputes from that.
+//  - Panel sizes: WinForms sizes the panels as soon as the split or the container changes, even while layout
+//    is suspended; Majorsilence docks them on the next layout. Children anchored in a panel take their
+//    distances from the panel's size when the designer code places them, so they need the real size then
+//    (Quests' goal list grew to twice its size).
+//  - Collapsing: a collapsed panel gives its space to the other one and the splitter disappears.
+
+#if MAJORSILENCE_FORMS
+using System;
+using System.Drawing;
+using System.Linq;
+using Majorsilence.Forms;
+
+namespace WhereAreWe;
+
+public class WinFormsSplitContainer : SplitContainer
+{
+	private double m_splitRatio;
+
+	private int m_fixedPanelSize;
+
+	private bool m_bAdjusting;
+
+	public WinFormsSplitContainer()
+	{
+		// Panel1's size changes outside this class only when the split is set, by code or by dragging
+		Panel1.SizeChanged += delegate
+		{
+			if (!m_bAdjusting)
+			{
+				RememberSplit();
+				m_bAdjusting = true;
+				try
+				{
+					SizePanels();
+				}
+				finally
+				{
+					m_bAdjusting = false;
+				}
+			}
+		};
+		SizeChanged += delegate
+		{
+			if (!m_bAdjusting)
+			{
+				m_bAdjusting = true;
+				try
+				{
+					ApplyRememberedSplit();
+					SizePanels();
+				}
+				finally
+				{
+					m_bAdjusting = false;
+				}
+			}
+		};
+	}
+
+	private int SplitExtent => (Orientation == Orientation.Vertical) ? ClientSize.Width : ClientSize.Height;
+
+	private void RememberSplit()
+	{
+		int extent = SplitExtent;
+		if (extent > 0)
+		{
+			m_splitRatio = (double)SplitterDistance / extent;
+			m_fixedPanelSize = (FixedPanel == FixedPanel.Panel2) ? (extent - SplitterDistance - SplitterWidth) : SplitterDistance;
+		}
+	}
+
+	private bool ApplyRememberedSplit()
+	{
+		int extent = SplitExtent;
+		if (extent <= 0 || m_splitRatio <= 0.0 || Panel1.Dock == DockStyle.Fill)
+		{
+			return false;
+		}
+		int distance = FixedPanel switch
+		{
+			FixedPanel.Panel1 => m_fixedPanelSize,
+			FixedPanel.Panel2 => extent - m_fixedPanelSize - SplitterWidth,
+			_ => (int)Math.Floor(extent * m_splitRatio),
+		};
+		int before = SplitterDistance;
+		if (distance != before)
+		{
+			SplitterDistance = distance;
+		}
+		return SplitterDistance != before;
+	}
+
+	private void SizePanels()
+	{
+		// (a container squeezed to nothing for a moment -- a form's client area is 0x0 before it's sized -- keeps
+		// its panels: anchored children would take the empty panel as their reference)
+		if (Panel1.Dock == DockStyle.Fill || SplitExtent <= SplitterDistance + SplitterWidth)
+		{
+			return;
+		}
+		Rectangle r = DisplayRectangle;
+		int d = SplitterDistance;
+		int start = d + SplitterWidth;
+		if (Orientation == Orientation.Vertical)
+		{
+			Panel1.Bounds = new Rectangle(r.X, r.Y, d, r.Height);
+			Panel2.Bounds = new Rectangle(r.X + start, r.Y, Math.Max(0, r.Width - start), r.Height);
+		}
+		else
+		{
+			Panel1.Bounds = new Rectangle(r.X, r.Y, r.Width, d);
+			Panel2.Bounds = new Rectangle(r.X, r.Y + start, r.Width, Math.Max(0, r.Height - start));
+		}
+	}
+
+	private bool UpdateCollapsedPanels()
+	{
+		// Majorsilence collapses a panel by hiding it; its own visibility can be told from an ancestor's only
+		// while the container is shown.
+		if (!Visible)
+		{
+			return Panel1.Dock == DockStyle.Fill;
+		}
+		bool panel2Collapsed = !Panel2.Visible;
+		DockStyle dock = panel2Collapsed ? DockStyle.Fill : ((Orientation == Orientation.Vertical) ? DockStyle.Left : DockStyle.Top);
+		bool showSplitter = Panel1.Visible && Panel2.Visible;
+		Splitter splitter = Controls.OfType<Splitter>().FirstOrDefault();
+		if (Panel1.Dock != dock || (splitter != null && splitter.Visible != showSplitter))
+		{
+			SuspendLayout();
+			Panel1.Dock = dock;
+			if (splitter != null)
+			{
+				splitter.Visible = showSplitter;
+			}
+			ResumeLayout(performLayout: false);
+		}
+		return panel2Collapsed;
+	}
+
+	protected override void OnLayout(LayoutEventArgs e)
+	{
+		// Majorsilence lays the container out from its constructor, before the panels exist
+		if (Panel1 == null)
+		{
+			base.OnLayout(e);
+			return;
+		}
+		m_bAdjusting = true;
+		FixedPanel fixedPanel = FixedPanel;
+		try
+		{
+			if (!UpdateCollapsedPanels())
+			{
+				ApplyRememberedSplit();
+			}
+			// Majorsilence would rescale the split once more, from the size of its last layout -- the default size
+			// for designer-made containers, whose layouts were suspended meanwhile. Docking the panels at that
+			// split, however briefly, makes anchored children in them take it as their reference.
+			FixedPanel = FixedPanel.Panel1;
+			base.OnLayout(e);
+		}
+		finally
+		{
+			FixedPanel = fixedPanel;
+			m_bAdjusting = false;
+		}
+	}
+}
+#endif
